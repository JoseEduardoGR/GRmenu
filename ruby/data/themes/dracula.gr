GRmenu::config<-1->

@theme:: "Dracula Dark"
@author:: "grcode"
@version:: "1.0"

<<menu
  style:: 7
  banner_style:: 7
  font:: 1
  animate:: fade
  center:: true
  border:: purple:2
  title:: pink:2
  subtitle:: cyan:1
  banner:: purple:2
  divider:: magenta:1
  options:: white:1
  focus:: green:2
  description:: gray:1
>>

<<table
  style:: 7
  header_color:: pink:2
  border_color:: purple:2
  row_color:: white:1
  selected_row:: green:2
  zebra_striping:: true
  animate:: fade
>>

<<card
  style:: 7
  border_color:: purple:2
  title_color:: pink:2
  content_color:: white:1
  icon_style:: brackets
>>

<<slider
  style:: 7
  color:: pink:2
  fill_char:: █
  empty_char:: ░
>>

<<checkbox
  style:: 7
  color:: purple:2
  checked_mark:: [X]
  unchecked_mark:: [ ]
>>

<<modal
  style:: 7
  border_color:: purple:2
  prompt_color:: cyan:2
  mask_char:: *
>>
