GRmenu::config<-1->

@theme:: "Sunset Glow"
@author:: "grcode"
@version:: "1.0"

<<menu
  style:: 19
  banner_style:: 19
  font:: 1
  animate:: fade
  center:: true
  border:: orange:2
  title:: yellow:2
  subtitle:: pink:1
  banner:: red:2
  divider:: orange:1
  options:: white:1
  focus:: yellow:2
  description:: gray:1
>>

<<table
  style:: 19
  header_color:: orange:2
  border_color:: red:2
  row_color:: white:1
  selected_row:: yellow:2
  zebra_striping:: true
  animate:: fade
>>

<<card
  style:: 19
  border_color:: orange:2
  title_color:: yellow:2
  content_color:: white:1
  icon_style:: brackets
>>

<<slider
  style:: 19
  color:: orange:2
  fill_char:: █
  empty_char:: ░
>>

<<checkbox
  style:: 19
  color:: yellow:2
  checked_mark:: [X]
  unchecked_mark:: [ ]
>>

<<modal
  style:: 19
  border_color:: orange:2
  prompt_color:: yellow:2
  mask_char:: *
>>
