GRmenu::config<-1->

@theme:: "Nord Frost"
@author:: "grcode"
@version:: "1.0"

<<menu
  style:: 6
  banner_style:: 6
  font:: 1
  animate:: linear
  center:: true
  border:: cyan:2
  title:: blue:2
  subtitle:: white:1
  banner:: cyan:2
  divider:: blue:1
  options:: white:1
  focus:: aqua:2
  description:: gray:1
>>

<<table
  style:: 6
  header_color:: cyan:2
  border_color:: blue:2
  row_color:: white:1
  selected_row:: aqua:2
  zebra_striping:: true
  animate:: linear
>>

<<card
  style:: 6
  border_color:: cyan:2
  title_color:: aqua:2
  content_color:: white:1
  icon_style:: brackets
>>

<<slider
  style:: 6
  color:: cyan:2
  fill_char:: █
  empty_char:: ░
>>

<<checkbox
  style:: 6
  color:: aqua:2
  checked_mark:: [X]
  unchecked_mark:: [ ]
>>

<<modal
  style:: 6
  border_color:: blue:2
  prompt_color:: cyan:2
  mask_char:: *
>>
