GRmenu::config<-1->

@theme:: "Monokai Pro"
@author:: "grcode"
@version:: "1.0"

<<menu
  style:: 4
  banner_style:: 4
  font:: 1
  animate:: diagonal
  center:: true
  border:: yellow:2
  title:: green:2
  subtitle:: orange:1
  banner:: yellow:2
  divider:: magenta:1
  options:: white:1
  focus:: magenta:2
  description:: gray:1
>>

<<table
  style:: 4
  header_color:: yellow:2
  border_color:: magenta:2
  row_color:: white:1
  selected_row:: green:2
  zebra_striping:: true
  animate:: diagonal
>>

<<card
  style:: 4
  border_color:: yellow:2
  title_color:: green:2
  content_color:: white:1
  icon_style:: brackets
>>

<<slider
  style:: 4
  color:: orange:2
  fill_char:: █
  empty_char:: ░
>>

<<checkbox
  style:: 4
  color:: green:2
  checked_mark:: [X]
  unchecked_mark:: [ ]
>>

<<modal
  style:: 4
  border_color:: yellow:2
  prompt_color:: magenta:2
  mask_char:: *
>>
